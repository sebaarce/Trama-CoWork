---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ReferralModal from "../../components/ReferralModal.astro";
---

<DashboardLayout title="TRAMA - Panel profesional">
  <header class="mb-8 border-b border-outline-variant/15 pb-6">
    <h1
      id="dashboard-greeting"
      class="text-3xl font-black tracking-tight text-on-surface"
    >
      Panel profesional
    </h1>
    <p class="mt-2 text-sm font-medium text-on-surface-variant">
      Seguimiento de tu actividad, validaciones y estado de suscripci&oacute;n.
    </p>
  </header>

  <section id="dashboard-loading" class="space-y-6">
    <div
      class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5"
    >
      <div class="flex items-center gap-3">
        <span
          class="material-symbols-outlined animate-spin text-primary"
          aria-hidden="true">progress_activity</span
        >
        <p class="text-sm font-semibold text-on-surface">
          Cargando datos del dashboard...
        </p>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        Array.from({ length: 8 }).map(() => (
          <article class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5">
            <div class="h-4 w-2/3 animate-pulse rounded bg-surface-container" />
            <div class="mt-4 h-9 w-1/3 animate-pulse rounded bg-surface-container" />
          </article>
        ))
      }
    </div>
  </section>

  <section
    id="dashboard-error"
    class="hidden rounded-2xl border border-error/20 bg-error/10 p-5"
  >
    <div class="flex items-start gap-3">
      <span class="material-symbols-outlined text-error" aria-hidden="true"
        >error</span
      >
      <div>
        <p class="text-sm font-bold text-error">No pudimos cargar tu panel.</p>
        <p
          id="dashboard-error-message"
          class="mt-1 text-sm text-on-surface-variant"
        >
          Intentá de nuevo en unos minutos.
        </p>
      </div>
    </div>
  </section>

  <section id="dashboard-content" class="hidden space-y-6">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      <article
        class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5"
      >
        <div class="flex items-center gap-2 text-on-surface-variant">
          <span class="material-symbols-outlined text-base" aria-hidden="true"
            >contacts</span
          >
          <p class="text-xs font-bold uppercase tracking-widest">Contactos</p>
        </div>
        <p id="total-contacts" class="mt-3 text-3xl font-black text-primary">
          0
        </p>
      </article>
      <article
        class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5"
      >
        <div class="flex items-center gap-2 text-on-surface-variant">
          <span class="material-symbols-outlined text-base" aria-hidden="true"
            >school</span
          >
          <p class="text-xs font-bold uppercase tracking-widest">Estudios</p>
        </div>
        <p id="total-educations" class="mt-3 text-3xl font-black text-primary">
          0
        </p>
      </article>
      <article
        class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5"
      >
        <div class="flex items-center gap-2 text-on-surface-variant">
          <span class="material-symbols-outlined text-base" aria-hidden="true"
            >workspace_premium</span
          >
          <p class="text-xs font-bold uppercase tracking-widest">
            Certificaciones
          </p>
        </div>
        <p
          id="total-certifications"
          class="mt-3 text-3xl font-black text-primary"
        >
          0
        </p>
      </article>
      <article
        class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5"
      >
        <div class="flex items-center gap-2 text-on-surface-variant">
          <span class="material-symbols-outlined text-base" aria-hidden="true"
            >description</span
          >
          <p class="text-xs font-bold uppercase tracking-widest">Documentos</p>
        </div>
        <p id="total-documents" class="mt-3 text-3xl font-black text-primary">
          0
        </p>
      </article>
      <article
        class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5"
      >
        <div class="flex items-center gap-2 text-on-surface-variant">
          <span class="material-symbols-outlined text-base" aria-hidden="true"
            >chat</span
          >
          <p class="text-xs font-bold uppercase tracking-widest">Mensajes</p>
        </div>
        <p id="total-messages" class="mt-3 text-3xl font-black text-primary">
          0
        </p>
      </article>
      <article
        class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5"
      >
        <div class="flex items-center gap-2 text-on-surface-variant">
          <span class="material-symbols-outlined text-base" aria-hidden="true"
            >forum</span
          >
          <p class="text-xs font-bold uppercase tracking-widest">
            Posts en comunidad
          </p>
        </div>
        <p
          id="total-community-posts"
          class="mt-3 text-3xl font-black text-primary"
        >
          0
        </p>
      </article>
      <article
        class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5"
      >
        <div class="flex items-center gap-2 text-on-surface-variant">
          <span class="material-symbols-outlined text-base" aria-hidden="true"
            >work</span
          >
          <p class="text-xs font-bold uppercase tracking-widest">
            Postulaciones
          </p>
        </div>
        <p
          id="total-job-applications"
          class="mt-3 text-3xl font-black text-primary"
        >
          0
        </p>
      </article>
      <article
        class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5"
      >
        <div class="flex items-center gap-2 text-on-surface-variant">
          <span class="material-symbols-outlined text-base" aria-hidden="true"
            >verified</span
          >
          <p class="text-xs font-bold uppercase tracking-widest">
            Validaciones
          </p>
        </div>
        <p id="total-validations" class="mt-3 text-3xl font-black text-primary">
          0
        </p>
      </article>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      <article
        id="referral-card"
        class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5"
      >
        <div class="flex items-center gap-2 text-on-surface-variant">
          <span class="material-symbols-outlined text-base" aria-hidden="true"
            >share</span
          >
          <p class="text-xs font-bold uppercase tracking-widest">Código de referido</p>
        </div>
        <p id="referral-code-value" class="mt-3 text-xl font-black text-primary">
          No disponible
        </p>
        <div class="mt-4 flex gap-2">
          <button
            id="referral-copy-button"
            type="button"
            class="rounded-xl bg-primary px-4 py-2 text-sm font-bold text-on-primary transition-all hover:brightness-110 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50"
            disabled
          >
            Copiar link
          </button>
          <button
            id="referral-manage-button"
            type="button"
            class="rounded-xl border border-outline-variant/25 px-4 py-2 text-sm font-bold text-on-surface transition-colors hover:bg-surface-container"
          >
            Gestionar código
          </button>
        </div>
      </article>
      <article
        id="plan-card"
        class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5"
      >
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2 text-on-surface-variant">
            <span class="material-symbols-outlined text-base" aria-hidden="true">workspace_premium</span>
            <p class="text-xs font-bold uppercase tracking-widest">Estado del plan</p>
          </div>
          <span
            id="plan-status-badge"
            class="shrink-0 rounded-full px-2.5 py-0.5 text-[11px] font-bold bg-outline/10 text-outline"
          >
            Sin plan
          </span>
        </div>
        <p id="plan-name" class="mt-3 truncate text-lg font-black text-on-surface">
          Sin plan activo
        </p>
        <p id="plan-expiration" class="mt-1 text-xs text-on-surface-variant"></p>
        <p id="plan-days-left" class="mt-2 text-sm font-bold text-on-surface-variant"></p>
      </article>
      <div data-referral-empty-slot="1" aria-hidden="true"></div>
      <div data-referral-empty-slot="2" aria-hidden="true"></div>
    </div>

  </section>

  <ReferralModal />

  <script>
    import {
      getReferralCode,
      getToken,
      logout,
      restoreSession,
    } from "../../services/authService";
    import {
      fetchProfessionalDashboard,
      type ProfessionalDashboard,
    } from "../../services/dashboardService";

    console.log("[DASHBOARD] Script loaded");

    const REFERRAL_BASE_URL = "https://tramacowork.com/registro?ref=";
    const REFERRAL_UNAVAILABLE_LABEL = "No disponible";
    const COPY_DEFAULT_LABEL = "Copiar link";
    const COPY_SUCCESS_LABEL = "¡Copiado!";
    const COPY_RESET_DELAY_MS = 2000;

    let referralCode: string | null = null;
    let copyFeedbackTimeout: number | null = null;

    function formatInteger(value: number): string {
      const safeValue = Number.isFinite(value) ? Math.trunc(value) : 0;
      return safeValue.toLocaleString("es-AR");
    }

    function formatDate(value: string | null): string {
      if (!value) return "â€”";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "â€”";
      return date.toLocaleDateString("es-AR", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
      });
    }

    function setTotal(elementId: string, value: number): void {
      const element = document.getElementById(elementId);
      if (!element) return;
      element.textContent = formatInteger(value);
    }

    function updateReferralCardState(): void {
      const codeValue = document.getElementById("referral-code-value");
      const copyButton = document.getElementById(
        "referral-copy-button",
      ) as HTMLButtonElement | null;

      if (codeValue) {
        codeValue.textContent = referralCode ?? REFERRAL_UNAVAILABLE_LABEL;
      }

      if (!copyButton) return;
      copyButton.disabled = !referralCode;
      if (!copyButton.disabled) {
        copyButton.textContent = COPY_DEFAULT_LABEL;
      }
    }

    async function loadReferralCodeData(): Promise<void> {
      try {
        const data = await getReferralCode();
        referralCode = data.referralCode;
      } catch {
        referralCode = null;
      }
      updateReferralCardState();
    }

    function getReferralRegistrationUrl(code: string): string {
      return `${REFERRAL_BASE_URL}${encodeURIComponent(code)}`;
    }

    async function copyReferralLink(): Promise<void> {
      if (!referralCode) return;
      try {
        await navigator.clipboard.writeText(getReferralRegistrationUrl(referralCode));
      } catch {
        return;
      }

      const copyButton = document.getElementById(
        "referral-copy-button",
      ) as HTMLButtonElement | null;
      if (!copyButton) return;

      copyButton.textContent = COPY_SUCCESS_LABEL;
      if (copyFeedbackTimeout !== null) {
        window.clearTimeout(copyFeedbackTimeout);
      }
      copyFeedbackTimeout = window.setTimeout(() => {
        copyButton.textContent = COPY_DEFAULT_LABEL;
      }, COPY_RESET_DELAY_MS);
    }

    function openReferralModal(): void {
      (window as any).openReferralModal?.(referralCode);
    }

    function setupReferralActions(): void {
      const copyButton = document.getElementById("referral-copy-button");
      const manageButton = document.getElementById("referral-manage-button");

      copyButton?.addEventListener("click", () => {
        void copyReferralLink();
      });

      manageButton?.addEventListener("click", openReferralModal);

      document.addEventListener("referral-code-updated", (event) => {
        const detail = (event as CustomEvent<{ referralCode: string }>).detail;
        if (!detail || typeof detail.referralCode !== "string") return;
        referralCode = detail.referralCode;
        updateReferralCardState();
      });
    }

    function renderPlanState(data: ProfessionalDashboard): void {
      const badge = document.getElementById("plan-status-badge");
      const planName = document.getElementById("plan-name");
      const planExpiration = document.getElementById("plan-expiration");
      const planDaysLeft = document.getElementById("plan-days-left");

      if (planName) {
        planName.textContent = data.planName ?? "Sin plan activo";
      }

      // Próximo vencimiento: en prueba usa trialEndDate; con plan, planExpirationDate.
      const nextDate = data.isOnTrial
        ? data.trialEndDate
        : data.planExpirationDate;
      const daysLeft = nextDate
        ? Math.ceil((new Date(nextDate).getTime() - Date.now()) / 86_400_000)
        : null;
      const isExpired = daysLeft !== null && daysLeft < 0;

      if (planExpiration) {
        planExpiration.textContent = nextDate
          ? `Próximo vencimiento: ${formatDate(nextDate)}`
          : "";
      }

      if (planDaysLeft) {
        let text = "";
        let cls = "text-on-surface-variant";
        if (daysLeft === null) {
          text = data.planName ? "" : "Sin plan activo";
        } else if (daysLeft > 1) {
          text = `Quedan ${daysLeft} días`;
          cls = "text-primary";
        } else if (daysLeft === 1) {
          text = "Vence mañana";
          cls = "text-primary";
        } else if (daysLeft === 0) {
          text = "Vence hoy";
          cls = "text-error";
        } else {
          text = "Vencido";
          cls = "text-error";
        }
        planDaysLeft.textContent = text;
        planDaysLeft.className = `mt-2 text-sm font-bold ${cls}`;
      }

      if (!badge) return;
      const badgeBase =
        "shrink-0 rounded-full px-2.5 py-0.5 text-[11px] font-bold";
      if (isExpired) {
        badge.textContent = "Vencido";
        badge.className = `${badgeBase} bg-error/15 text-error`;
      } else if (data.isOnTrial) {
        badge.textContent = "Prueba";
        badge.className = `${badgeBase} bg-secondary-container text-on-secondary-container`;
      } else if (data.planName) {
        badge.textContent = "Activo";
        badge.className = `${badgeBase} bg-primary/20 text-primary`;
      } else {
        badge.textContent = "Sin plan";
        badge.className = `${badgeBase} bg-outline/10 text-outline`;
      }
    }
    function showState(mode: "loading" | "error" | "content"): void {
      const loading = document.getElementById("dashboard-loading");
      const error = document.getElementById("dashboard-error");
      const content = document.getElementById("dashboard-content");

      loading?.classList.toggle("hidden", mode !== "loading");
      error?.classList.toggle("hidden", mode !== "error");
      content?.classList.toggle("hidden", mode !== "content");
    }

    function showErrorMessage(message: string): void {
      const errorMessage = document.getElementById("dashboard-error-message");
      if (errorMessage) {
        errorMessage.textContent = message;
      }
      showState("error");
    }

    async function loadDashboard(): Promise<void> {
      try {
        restoreSession();

        const token = getToken();
        if (!token) {
          showErrorMessage(
            "Sesión expirada. Volvé a iniciar sesión para ver tu panel.",
          );
          return;
        }

        showState("loading");

        console.log("[DASHBOARD] About to fetch");
        const dashboardData: ProfessionalDashboard =
          await fetchProfessionalDashboard();

        setTotal("total-contacts", dashboardData.totalContacts);
        setTotal("total-educations", dashboardData.totalEducations);
        setTotal("total-certifications", dashboardData.totalCertifications);
        setTotal("total-documents", dashboardData.totalDocuments);
        setTotal("total-messages", dashboardData.totalMessages);
        setTotal("total-community-posts", dashboardData.totalCommunityPosts);
        setTotal("total-job-applications", dashboardData.totalJobApplications);
        setTotal("total-validations", dashboardData.totalValidations);
        renderPlanState(dashboardData);

        showState("content");
        void loadReferralCodeData();
      } catch (err: any) {
        console.error(
          "[dashboard] Error while loading professional dashboard",
          err,
        );
        showErrorMessage(
          "No se pudieron obtener tus métricas. Intentá nuevamente.",
        );
      }
    }

    let hasLoadedDashboard = false;

    function initializeDashboard(): void {
      if (hasLoadedDashboard) return;
      hasLoadedDashboard = true;
      setupReferralActions();
      updateReferralCardState();
      void loadDashboard();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeDashboard, {
        once: true,
      });
    } else {
      initializeDashboard();
    }

    document.addEventListener("astro:page-load", initializeDashboard);
  </script>
</DashboardLayout>
