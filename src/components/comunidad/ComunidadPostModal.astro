---
  import ConfirmModal from '../../components/ConfirmModal.astro';
---

<!-- Comments Modal -->
<div id="comments-modal" class="fixed inset-0 z-50 flex items-end justify-center opacity-0 pointer-events-none transition-opacity duration-300" role="dialog" aria-modal="true" aria-labelledby="comments-sheet-title">
  <div id="modal-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
  <div id="comments-sheet" class="relative w-full max-w-2xl max-h-[88vh] bg-surface-container rounded-t-2xl shadow-2xl flex flex-col overflow-hidden border border-outline-variant/15 translate-y-full transition-transform duration-300 ease-out">
    <div class="shrink-0 px-5 pt-2.5 pb-3 border-b border-outline-variant/15">
      <div class="mx-auto mb-3 h-1.5 w-10 rounded-full bg-outline-variant/40"></div>
      <div class="flex items-center justify-between gap-3">
        <h3 id="comments-sheet-title" class="text-base font-bold text-on-surface">Comentarios</h3>
        <button id="modal-close-btn" class="p-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low transition-colors" aria-label="Cerrar">
          <span class="material-symbols-outlined text-xl" aria-hidden="true">close</span>
        </button>
      </div>
    </div>
    <div id="modal-comments-wrapper" class="flex-1 overflow-y-auto px-5 py-3 space-y-2 min-h-0">
      <div id="modal-comments-list" class="space-y-2"></div>
      <div id="modal-comments-loader" class="hidden text-center py-3">
        <span class="material-symbols-outlined text-xl text-primary animate-spin" aria-hidden="true">schedule</span>
      </div>
    </div>
    <form id="modal-comment-form" class="shrink-0 flex items-center gap-2 border-t border-outline-variant/15 px-4 py-3 bg-surface-container">
      <input
        id="modal-comment-input"
        type="text"
        autocomplete="off"
        placeholder="Escribí un comentario…"
        class="flex-1 rounded-full border border-outline-variant/20 bg-surface-container-lowest px-4 py-2.5 text-sm text-on-surface placeholder:text-on-surface-variant/70 focus:border-primary focus:outline-none"
      />
      <button
        id="modal-comment-send"
        type="submit"
        class="shrink-0 w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center transition-all hover:brightness-110 active:scale-95 disabled:opacity-50"
        aria-label="Enviar comentario"
      >
        <span class="material-symbols-outlined text-lg" aria-hidden="true">send</span>
      </button>
    </form>
  </div>
</div>

<ConfirmModal />

<script>
  import {
    fetchChannelPostComments,
    fetchPostComments,
    createComment,
    createChannelComment,
    deleteComment,
    deleteChannelComment,
    type Channel,
    type Comment,
  } from '../../services/communityService';
  import { getUserIdFromToken } from '../../services/authService';
  import { fetchProfile, getProfilePhotoUrl } from '../../services/profileService';
  import { escapeHtml, formatDate } from '../../utils/helpers';
  import { renderMarkdown } from '../../utils/markdown';
  import { renderReactionBar, initReactionBars } from './reactionBar';
  import { commentTargetType } from '../../services/reactionsService';

  type ModalOpenDetail = {
    postId: string;
    channelType?: Channel['type'];
    channelSlug?: string;
    channelId?: string;
  };

  const userId = getUserIdFromToken();

  const commentsModal = document.getElementById('comments-modal')!;
  const commentsSheet = document.getElementById('comments-sheet')!;
  const modalBackdrop = document.getElementById('modal-backdrop')!;
  const modalCloseBtn = document.getElementById('modal-close-btn')!;
  const modalCommentsList = document.getElementById('modal-comments-list')!;
  const modalCommentsLoader = document.getElementById('modal-comments-loader')!;
  const modalCommentsWrapper = document.getElementById('modal-comments-wrapper')!;
  const modalCommentForm = document.getElementById('modal-comment-form') as HTMLFormElement;
  const modalCommentInput = document.getElementById('modal-comment-input') as HTMLInputElement;
  const modalCommentSend = document.getElementById('modal-comment-send') as HTMLButtonElement;

  initReactionBars();

  let modalPostId: string | null = null;
  let modalChannelType: Channel['type'] = 'community';
  let modalChannelSlug = '';
  let modalChannelId = '';
  let modalCurrentPage = 1;
  let modalTotalPages = 1;
  let isSubmittingComment = false;
  let isLoadingComments = false;
  let currentUserProfile: { name: string; photoUrl: string | null } | null = null;
  let currentUserProfilePromise: Promise<void> | null = null;

  function ensureCurrentUserProfile(): Promise<void> {
    if (currentUserProfile || !userId) return Promise.resolve();
    if (currentUserProfilePromise) return currentUserProfilePromise;

    currentUserProfilePromise = fetchProfile(userId)
      .then((profile) => {
        currentUserProfile = {
          name: profile.name || '',
          photoUrl: profile.photo ? `/uploads/photo/${profile.id}` : null,
        };
      })
      .catch(() => {
        // Silencioso: si falla, el nombre se resuelve al reabrir (viene del back).
      });

    return currentUserProfilePromise;
  }

  function renderCommentHtml(comment: Comment): string {
    const commenterName = comment.user?.profile?.name || comment.user?.email || 'Usuario';
    return `
      <div class="flex items-start gap-2 bg-surface-container-low rounded-lg p-3" data-comment-id="${comment.id}">
        <img src="${escapeHtml(getProfilePhotoUrl(comment.user?.photoUrl, comment.user?.id || ''))}" alt="" class="w-6 h-6 rounded-full object-cover bg-surface-container shrink-0" loading="lazy" onerror="this.onerror=null;this.src='/images/default-avatar.svg'" />
        <div class="flex-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-on-surface">${escapeHtml(commenterName)}</span>
            <span class="text-[10px] text-on-surface-variant">${escapeHtml(formatDate(comment.createdAt))}</span>
          </div>
          <div class="markdown-content text-xs text-on-surface-variant mt-0.5">${renderMarkdown(comment.content)}</div>
          <div class="mt-1.5">
            ${renderReactionBar({ targetType: commentTargetType(modalChannelType), targetId: comment.id, reactions: comment.reactions, myReaction: comment.myReaction, compact: true })}
          </div>
        </div>
        ${comment.userId === userId ? `
          <button class="btn-delete-comment text-on-surface-variant hover:text-error transition-colors p-0.5" data-comment-id="${comment.id}" title="Eliminar comentario">
            <span class="material-symbols-outlined text-xs" aria-hidden="true">close</span>
          </button>` : ''}
      </div>`;
  }

  function renderCommentsEmpty() {
    modalCommentsList.innerHTML = `
      <div data-empty-state class="flex flex-col items-center justify-center gap-3 py-14 text-center">
        <span class="text-5xl" aria-hidden="true">💬</span>
        <p class="text-sm font-medium text-on-surface-variant">Todavía no hay comentarios.<br />¡Sé el primero en comentar!</p>
      </div>`;
  }

  function renderComments(comments: Comment[]) {
    modalCommentsList.innerHTML = '';
    if (comments.length === 0) {
      renderCommentsEmpty();
      return;
    }

    appendComments(comments);
  }

  function appendComments(comments: Comment[]) {
    comments.forEach(comment => {
      modalCommentsList.insertAdjacentHTML('beforeend', renderCommentHtml(comment));
    });
    bindModalDeleteButtons();
  }

  function updateCommentCountLabel(postId: string, delta: number) {
    document.querySelectorAll(`article[data-post-id="${postId}"] .comment-count-label`).forEach(label => {
      const text = label.textContent || '0';
      const current = parseInt(text, 10) || 0;
      const newCount = Math.max(0, current + delta);
      const isMyPost = text.includes('recibido');
      if (isMyPost) {
        label.textContent = `${newCount} ${newCount === 1 ? 'comentario recibido' : 'comentarios recibidos'}`;
        return;
      }
      label.textContent = `${newCount} ${newCount === 1 ? 'comentario' : 'comentarios'}`;
    });
  }

  async function loadModalComments(page: number) {
    if (!modalPostId || isLoadingComments) return;

    isLoadingComments = true;
    if (page > 1) {
      modalCommentsLoader.classList.remove('hidden');
    }

    try {
      const result = modalChannelType === 'channel'
        ? await fetchChannelPostComments(modalChannelId || modalChannelSlug, modalPostId, page, 10)
        : await fetchPostComments(modalPostId, page, 10);
      const comments = result.data || [];
      const meta = result.meta;
      modalCurrentPage = meta.page;
      modalTotalPages = meta.totalPages;

      if (page === 1) {
        renderComments(comments);
      } else {
        appendComments(comments);
      }
    } catch (err) {
      console.error('Error cargando comentarios:', err);
      if (page === 1) {
        modalCommentsList.innerHTML = '<p class="text-xs text-error text-center py-4">Error al cargar comentarios.</p>';
      }
    } finally {
      isLoadingComments = false;
      modalCommentsLoader.classList.add('hidden');
    }
  }

  async function openCommentsModal(detail: ModalOpenDetail) {
    if (!detail.postId) return;

    modalPostId = detail.postId;
    modalCurrentPage = 1;
    modalTotalPages = 1;
    modalChannelType = detail.channelType === 'channel' ? 'channel' : 'community';
    modalChannelSlug = detail.channelSlug || '';
    modalChannelId = detail.channelId || '';

    modalCommentsList.innerHTML = `
      <div class="flex items-center justify-center py-6">
        <span class="material-symbols-outlined text-2xl text-primary animate-spin" aria-hidden="true">schedule</span>
      </div>`;
    modalCommentsLoader.classList.add('hidden');
    modalCommentInput.value = '';
    modalCommentsWrapper.scrollTop = 0;

    commentsModal.classList.remove('opacity-0', 'pointer-events-none');
    commentsSheet.classList.remove('translate-y-full');
    document.body.style.overflow = 'hidden';

    void ensureCurrentUserProfile();
    await loadModalComments(1);
  }

  function closeCommentsModal() {
    commentsModal.classList.add('opacity-0', 'pointer-events-none');
    commentsSheet.classList.add('translate-y-full');
    document.body.style.overflow = '';
    modalPostId = null;
    modalChannelSlug = '';
    modalChannelId = '';
    modalChannelType = 'community';
    modalCommentsList.innerHTML = '';
  }

  function bindModalDeleteButtons() {
    modalCommentsList.querySelectorAll('.btn-delete-comment').forEach(button => {
      if ((button as HTMLElement).dataset.bound) return;
      (button as HTMLElement).dataset.bound = 'true';
      button.addEventListener('click', () => {
        if (!modalPostId) {
          return;
        }

        const commentId = (button as HTMLElement).dataset.commentId;
        if (!commentId) {
          return;
        }

        const postId = modalPostId;
        const channelType = modalChannelType;
        const channelId = modalChannelId || modalChannelSlug;

        (window as any).openConfirmModal({
          title: '¿Eliminar comentario?',
          message: 'Esta acción no se puede deshacer.',
          iconBgClass: 'bg-red-50',
          iconHtml: '<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>',
          buttons: [
            {
              text: 'Eliminar',
              icon: '<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>',
              variant: 'danger',
              onClick: async () => {
                try {
                  if (channelType === 'channel') {
                    await deleteChannelComment(channelId, postId, commentId);
                  } else {
                    await deleteComment(commentId);
                  }
                  const commentElement = modalCommentsList.querySelector(`[data-comment-id="${commentId}"]`);
                  if (commentElement) {
                    commentElement.remove();
                  }
                  updateCommentCountLabel(postId, -1);
                  if (modalCommentsList.children.length === 0) {
                    renderCommentsEmpty();
                  }
                } catch (err) {
                  console.error('Error eliminando comentario:', err);
                }
              },
            },
            { text: 'Cancelar', variant: 'ghost' },
          ],
        });
      });
    });
  }

  async function submitComment() {
    if (!modalPostId || isSubmittingComment) return;

    const content = modalCommentInput.value.trim();
    if (!content) return;

    isSubmittingComment = true;
    modalCommentSend.disabled = true;

    try {
      const channelId = modalChannelId || modalChannelSlug;
      const newComment = modalChannelType === 'channel' && channelId
        ? await createChannelComment(channelId, modalPostId, content)
        : await createComment(modalPostId, content);

      // El POST no devuelve el autor: completamos con tu perfil para mostrar
      // tu nombre/foto al instante (al reabrir ya viene del back).
      await ensureCurrentUserProfile();
      const commentToRender: Comment = (!newComment.user?.profile?.name && currentUserProfile)
        ? {
            ...newComment,
            userId: newComment.userId || userId || '',
            user: {
              id: userId || newComment.user?.id || '',
              email: newComment.user?.email || '',
              profile: { name: currentUserProfile.name },
              photoUrl: currentUserProfile.photoUrl,
            },
          }
        : newComment;

      const emptyState = modalCommentsList.querySelector('[data-empty-state]');
      if (emptyState) {
        modalCommentsList.innerHTML = '';
      }

      modalCommentsList.insertAdjacentHTML('afterbegin', renderCommentHtml(commentToRender));
      bindModalDeleteButtons();
      modalCommentsWrapper.scrollTop = 0;
      updateCommentCountLabel(modalPostId, 1);
      modalCommentInput.value = '';
    } catch (err) {
      console.error('Error creando comentario:', err);
    } finally {
      isSubmittingComment = false;
      modalCommentSend.disabled = false;
      modalCommentInput.focus();
    }
  }

  document.addEventListener('comunidad:modal-open-post', async event => {
    const customEvent = event as CustomEvent<ModalOpenDetail>;
    await openCommentsModal(customEvent.detail);
  });

  modalCloseBtn.addEventListener('click', closeCommentsModal);
  modalBackdrop.addEventListener('click', closeCommentsModal);

  modalCommentsWrapper.addEventListener('scroll', () => {
    if (isLoadingComments || modalCurrentPage >= modalTotalPages) return;
    const { scrollTop, clientHeight, scrollHeight } = modalCommentsWrapper;
    if (scrollTop + clientHeight >= scrollHeight - 80) {
      void loadModalComments(modalCurrentPage + 1);
    }
  });

  modalCommentForm.addEventListener('submit', (event) => {
    event.preventDefault();
    void submitComment();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modalPostId) {
      closeCommentsModal();
    }
  });
</script>
