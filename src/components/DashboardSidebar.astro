---
interface Props {
  profileStatus?: string | null;
}

const { profileStatus } = Astro.props;
const currentPath = Astro.url.pathname;

const sidebarLinks = [
  { href: '/dashboard', icon: 'dashboard', label: 'Resumen', requiresActive: false },
  { href: '/dashboard/perfil', icon: 'edit', label: 'Editar perfil', requiresActive: false },
  { href: '/dashboard/configuracion', icon: 'settings', label: 'Configuración', requiresActive: false },
  { href: '/dashboard/estudios', icon: 'school', label: 'Estudios', requiresActive: true },
  { href: '/dashboard/comunidad', icon: 'forum', label: 'Comunidad', requiresActive: true },
  { href: '/dashboard/trabajos', icon: 'work', label: 'Trabajos', requiresActive: true },
  { href: '/dashboard/pagos', icon: 'payments', label: 'Pagos', requiresActive: true },
];

const isPaymentGated = profileStatus === 'waiting_payment';

// When payment gated, only show Resumen and Pagos
const allowedWhenGated = ['/dashboard', '/dashboard/pagos'];
const visibleLinks = isPaymentGated
  ? sidebarLinks.filter((link) =>
      allowedWhenGated.some((allowed) => link.href === allowed || (allowed !== '/dashboard' && link.href.startsWith(`${allowed}/`)))
    )
  : sidebarLinks;

function isActive(href: string): boolean {
  if (href === '/dashboard') return currentPath === '/dashboard' || currentPath === '/dashboard/';
  return currentPath.startsWith(href);
}

// Placeholder – real data loaded client-side
const mockUser = {
  name: '',
  role: '',
  avatar: '',
};
---

<aside class="h-screen w-64 border-r border-outline-variant/15 bg-surface-container-low flex flex-col py-6 gap-2 sticky top-0 shrink-0">
  <!-- Header -->
  <div class="px-6 mb-8">
    <a href="/" class="text-lg font-bold text-on-surface tracking-tighter hover:text-primary transition-colors">
      Portal Profesional
    </a>
    <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-widest mt-1">
      Gestiona tu perfil
    </p>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 space-y-1" aria-label="Panel de control">
    {visibleLinks.map((link) => (
      <a
        href={link.href}
        class={`${link.requiresActive && !isPaymentGated ? 'hidden ' : ''}${isActive(link.href)
          ? 'bg-primary/10 text-primary rounded-lg mx-2 flex items-center px-4 py-3 gap-3 transition-transform duration-200 hover:translate-x-1 text-sm font-bold'
          : 'text-on-surface-variant hover:bg-surface-container mx-2 flex items-center px-4 py-3 gap-3 transition-transform duration-200 hover:translate-x-1 text-sm font-semibold rounded-lg'}`}
        aria-current={isActive(link.href) ? 'page' : undefined}
        data-requires-active={link.requiresActive && !isPaymentGated ? '' : undefined}
      >
        <span class="material-symbols-outlined" aria-hidden="true">{link.icon}</span>
        <span>{link.label}</span>
      </a>
    ))}
  </nav>

  <!-- User Card -->
  <div class="px-4 mt-auto">
    <div class="bg-surface-container-lowest p-4 rounded-xl shadow-sm border border-outline-variant/10">
      <div class="flex items-center gap-3 mb-3">
        <img
          id="sidebar-user-avatar"
          alt="Foto de perfil"
          class="w-10 h-10 rounded-full object-cover"
          src={mockUser.avatar}
        />
        <div>
          <p id="sidebar-user-name" class="text-sm font-bold text-on-surface">{mockUser.name}</p>
          <p id="sidebar-user-role" class="text-[10px] text-on-surface-variant uppercase tracking-tighter">{mockUser.role}</p>
        </div>
      </div>
      <a
        id="sidebar-profile-link"
        href="/profesionales"
        class="block w-full text-center bg-primary-container text-on-primary text-xs font-bold py-2 rounded-lg hover:opacity-90 active:scale-95 transition-all"
      >
        Ver perfil público
      </a>
      <button
        id="sidebar-logout-btn"
        type="button"
        class="block w-full text-center text-xs font-bold py-2 rounded-lg text-on-surface-variant border border-outline-variant/30 hover:bg-error/10 hover:text-error hover:border-error/30 transition-all mt-2"
      >
        Cerrar sesión
      </button>
    </div>
  </div>
</aside>

<script>
  import { buildProfileSlug } from '../utils/helpers';
  import { getUserIdFromToken, getToken, logout } from '../services/authService';
  import { api } from '../services/apiClient';
  import { getProfilePhotoUrl } from '../services/profileService';
  import type { ProfessionalProfile } from '../services/profileService';

  const DEFAULT_AVATAR = '/images/default-avatar.svg';

  async function loadSidebarUser() {
    const userId = getUserIdFromToken();
    const token = getToken();

    if (!userId || !token) return;

    api.setHeader('Authorization', `Bearer ${token}`);

    try {
      const data = await api.get<ProfessionalProfile>(`/professionals/by-user/${userId}`);

      // Avatar
      const avatar = document.getElementById('sidebar-user-avatar') as HTMLImageElement | null;
      if (avatar) {
        const photoUrl = getProfilePhotoUrl(data.id);
        avatar.onerror = () => { avatar.onerror = null; avatar.src = DEFAULT_AVATAR; };
        avatar.src = photoUrl;
      }

      // Name
      const name = document.getElementById('sidebar-user-name');
      if (name) name.textContent = data.name || '';

      // Role (first service)
      const role = document.getElementById('sidebar-user-role');
      if (role && data.services?.length > 0) role.textContent = data.services[0];

      // Profile link
      const link = document.getElementById('sidebar-profile-link') as HTMLAnchorElement | null;
      if (link) {
        link.href = data.publicId
          ? `/profesionales/${buildProfileSlug(data.name, data.publicId)}`
          : `/profesionales/perfil?id=${data.id}`;
      }

      // Show/hide menu items & public profile link based on access:
      // plan activo (profileStatus === 'active') o trial vigente (trialEndDate futuro).
      const isProfileActive = data.profileStatus === 'active';
      const onTrial = data.trialEndDate
        ? new Date(data.trialEndDate).getTime() > Date.now()
        : false;
      const hasAccess = isProfileActive || onTrial;
      if (hasAccess) {
        document.querySelectorAll('[data-requires-active]').forEach(el => {
          el.classList.remove('hidden');
        });
      }
      if (!isProfileActive) {
        // Hide "Ver perfil público" button (solo para perfiles no activos)
        if (link) link.classList.add('hidden');
      }
    } catch {
      // 401 handled globally by interceptor
    }
  }

  loadSidebarUser();

  // Logout button
  document.getElementById('sidebar-logout-btn')?.addEventListener('click', () => {
    logout('/login');
  });

  // Listen for photo updates from perfil.astro
  window.addEventListener('sidebar:update-photo', ((e: CustomEvent) => {
    const avatar = document.getElementById('sidebar-user-avatar') as HTMLImageElement | null;
    if (avatar) avatar.src = e.detail?.src || DEFAULT_AVATAR;
  }) as EventListener);
</script>

